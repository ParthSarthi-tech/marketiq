# Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Upstox Market Data API (Required for live Indian market data)
# Get your access token from: https://account.upstox.com/developer/apps
# Supported: LTP V3, OHLC V3, Historical Candle V3, Market Data Feed V3, Instrument Search, Market Status
VITE_UPSTOX_ACCESS_TOKEN=your_upstox_access_token

# Enable real-time WebSocket streaming (optional)
# Set to "true" to enable live price updates via Upstox WebSocket V3
VITE_ENABLE_REALTIME=true

# Gemini AI (Required - server-side)
GEMINI_API_KEY=your-gemini-api-key

# MarketAux News API (Required for news features)
# Get your API key from: https://www.marketaux.com/
MARKETAUX_API_KEY=your-marketaux-api-key